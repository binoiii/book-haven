generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id     Int    @id @default(autoincrement())
  title  String
  author String
  price  Float
  cover  String
  sku    String @unique
  stock  Int    @default(0)
}
